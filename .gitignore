# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk


*/.nvimlog

# Documentation generator has its own locked build dependencies.
/site/target/
!site/Cargo.lock
/dev/__pycache__/
/dev/tests/__pycache__/

# Instrumented fuzzing keeps its own dependency lock; findings stay local.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
!fuzz/Cargo.lock

# Guidance keeps frozen evidence and consumer lockfiles, not build/runtime paths.
/guidance/**/bundle/plugin/
/guidance/**/target/
!guidance/**/Cargo.lock
